{
  "name": "marram",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Marram components (early stage, not production-ready — see README), consumed as copy-source via the shadcn registry.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "npm run playground:manifest && vite build --base ./ --outDir site && storybook build -o site/storybook && shadcn build --output site/r",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "registry:check": "node scripts/check-registry.mjs",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs",
    "skills:check": "node scripts/check-skills.mjs && node --test scripts/check-skills.test.mjs scripts/ship-check.test.mjs",
    "ship:check": "node scripts/ship-check.mjs",
    "playground:manifest": "node scripts/build-playground-manifest.mjs",
    "playground:check": "node scripts/build-playground-manifest.mjs --check && node --test scripts/playground-docs.test.mjs",
    "lint": "oxlint && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\" \".storybook/**/*.css\" && node --test scripts/stylelint-semantic-tokens.test.mjs",
    "verify": "changeset status --since=origin/main && npm run tokens:check && npm run registry:check && npm run docs:check && npm run skills:check && npm run playground:check && npm run lint && tsc -b && vitest --project storybook run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "latest",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.81.0",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "10.6.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "three": "0.160.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "latest"
  }
}
